{
    "name": "fwx5618177/rtp",
    "description": "RTP Bridge Backend",
    "type": "project",
    "require": {
        "php": "^8.0",
        "ext-swoole": "*",
        "aws/aws-sdk-php": "^3.337",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "monolog/monolog": "^2.0",
        "php-di/php-di": "^7.0",
        "predis/predis": "^2.3",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.1",
        "symfony/cache": "^7.2",
        "symfony/mailer": "^7.2",
        "vlucas/phpdotenv": "^5.6",
        "rtckit/sip": "^0.7.1",
        "rtckit/sdp": "^0.1.1",
        "marcelog/pami": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "App\\Config\\Config::clearCache"
        ],
        "migrate:redis": "php database/redis-migrate.php",
        "start": "php src/index.php",
        "db:generate": "php vendor/bin/doctrine-migrations generate --configuration=./auto-migrations/migrations.php --db-configuration=./auto-migrations/migrations-db.php",
        "db:migrate": "php vendor/bin/doctrine-migrations migrate --configuration=./auto-migrations/migrations.php --db-configuration=./auto-migrations/migrations-db.php",
        "db:status": "php vendor/bin/doctrine-migrations status --configuration=./auto-migrations/migrations.php --db-configuration=./auto-migrations/migrations-db.php"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "swoole/ide-helper": "^6.0"
    }
}