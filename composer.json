{
    "name": "rtp-bridge/backend",
    "description": "RTP Bridge Backend",
    "type": "project",
    "require": {
        "php": "^8.0",
        "monolog/monolog": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "App\\Config\\Config::clearCache"
        ]
    }
}
