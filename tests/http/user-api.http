###############################################
# 用户管理 API 测试
###############################################

### 1. 用户注册
POST http://localhost:9501/api/users
Content-Type: application/json

{
    "username": "testuser",
    "email": "test@example.com",
    "password": "password123",
    "firstName": "Test",
    "lastName": "User"
}

### 2. 获取用户列表
GET http://localhost:9501/api/users
Content-Type: application/json

### 3. 获取单个用户信息
GET http://localhost:9501/api/users/1
Content-Type: application/json

### 4. 更新用户信息
PUT http://localhost:9501/api/users/1
Content-Type: application/json

{
    "firstName": "Updated",
    "lastName": "Name",
    "email": "updated@example.com"
}

### 5. 删除用户
DELETE http://localhost:9501/api/users/1
Content-Type: application/json

###############################################
# 错误处理测试
###############################################

### 8. 测试无效的用户注册
POST http://localhost:9501/api/users
Content-Type: application/json

{
    "username": "",
    "email": "invalid-email",
    "password": "123"
}

### 9. 测试获取不存在的用户
GET http://localhost:9501/api/users/999
Content-Type: application/json

### 10. 测试无效的用户更新
PUT http://localhost:9501/api/users/1
Content-Type: application/json

{
    "email": "invalid-email"
}

###############################################
# 中间件测试
###############################################

### 11. 测试条件中间件截断
GET http://localhost:9501/api/users
Content-Type: application/json
x-stop-here: true

### 12. 测试条件中间件跳过
GET http://localhost:9501/api/users
Content-Type: application/json
x-skip-condition: true

### 13. 测试流程中间件
GET http://localhost:9501/api/users
Content-Type: application/json
x-test-cutdown: true 