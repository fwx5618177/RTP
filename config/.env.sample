# APP ENV
APP_ENV=local
APP_PORT=9501

# DB Connection Pool
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2

# LOG
LOG_DIR="logs/"
LOG_ROTATE_FILE="rotate"
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=10
LOG_RETENTION_DAYS=30

# Database configuration
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rtp_bridge
DB_USER=rtp
DB_PASS=rtp123
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=60

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0
REDIS_PREFIX=rtp:
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0
REDIS_RETRY_INTERVAL=100
REDIS_READ_WRITE_TIMEOUT=2.0
REDIS_SCHEME=tcp
REDIS_PERSISTENT=true

# WebSocket configuration
WS_PORT=9502
WS_HOST=0.0.0.0
WS_PATH=/ws
WS_MAX_CONNECTIONS=1000
WS_TOKEN=test_token_123