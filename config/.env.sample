# APP ENV
APP_ENV=local
APP_PORT=9501

# DB Connection Pool
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_POOL_TIMEOUT=30 # 连接池超时时间
DB_POOL_IDLE_TIMEOUT=300 # 连接池空闲时间

# LOG
LOG_DIR="logs/"
LOG_ROTATE_FILE="rotate"
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=10
LOG_RETENTION_DAYS=30

# Database configuration
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rtp_bridge
DB_USER=rtp
DB_PASS=rtp123
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=60

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0
REDIS_PREFIX=rtp:
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0
REDIS_RETRY_INTERVAL=100
REDIS_READ_WRITE_TIMEOUT=2.0
REDIS_SCHEME=tcp
REDIS_PERSISTENT=true

# WebSocket configuration
WS_PORT=9502
WS_HOST=127.0.0.1
WS_PATH=/ws
WS_MAX_CONNECTIONS=1000
WS_TOKEN=test_token_123

# Janus Gateway Configuration
JANUS_HOST=127.0.0.1
JANUS_PORT=8088    # HTTP/WebSocket API 端口
JANUS_SIP_PORT=5060 # SIP 端口
JANUS_API_SECRET=janusrocks

# Janus 配置
JANUS_HTTP_ENDPOINT=http://127.0.0.1:8088/janus
JANUS_WS_ENDPOINT=ws://127.0.0.1:8188

# Asterisk AMI Configuration
ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=5038
ASTERISK_USERNAME=admin
ASTERISK_SECRET=admin123
ASTERISK_CONNECT_TIMEOUT=10
ASTERISK_READ_TIMEOUT=10
