# General configuration
general: {
  enabled = true
  json = "indented"
  base_path = "/usr/local/etc/janus"
  configs_path = "/usr/local/etc/janus"
  plugins_path = "/usr/local/lib/janus/plugins"
  transports_path = "/usr/local/lib/janus/transports"
  api_secret = "janusrocks"
  log_to_stdout = true
  log_level = 4
  log_timestamps = true
  log_colors = true
  log_prefix = "[janus]"
  log_file = "/var/log/janus/janus.log"
  log_max_size = "10M"
  log_max_files = 5
  log_rotate = true
  debug_level = 7
  debug_timestamps = true
  debug_colors = true
  interface = "0.0.0.0"
  session_timeout = 60
  plugins_folder = "/usr/local/lib/janus/plugins"
  transports_folder = "/usr/local/lib/janus/transports"
  events_folder = "/usr/local/lib/janus/events"
}

plugins: {
  disable = "libjanus_voicemail.so,libjanus_recordplay.so,libjanus_echotest.so"
}

transports: {
  disable = ""
}

media: {
  rtp_port_range = "10000-20000"
  nat_1_1_mapping = "1.2.3.4"
  dtls_mtu = 1200
}

nat: {
  ice_lite = true
  ice_tcp = false
  nice_debug = false
}
